# Vector MCP Server Configuration
# ================================

# Vector Network Endpoints
VECTOR_OGMIOS_URL=https://ogmios.vector.testnet.apexfusion.org
VECTOR_KOIOS_URL=https://v2.koios.vector.testnet.apexfusion.org/
VECTOR_SUBMIT_URL=https://submit.vector.testnet.apexfusion.org/api/submit/tx
VECTOR_EXPLORER_URL=https://vector.testnet.apexscan.org

# Marketplace indexer behind the vector_marketplace_* tools. Read when the server starts, before this file
# is loaded, so it only takes effect as a real environment variable. The default is shown.
# VECTOR_MARKETPLACE_INDEXER_URL=https://mp-indexer.vector.apexfusion.org

# Identity registry (did:vector) deployment values, published with the deployment. Set both required values or
# none: without them the identity, attestation, delegation and vault tools answer "not configured". The server
# applies the parameters of the identity-marketplace scripts once, at startup; a malformed value stops the start.
# VECTOR_IDENTITY_LEGACY_ROOT=<64 hex: Merkle root of the adoption allowlist>
# VECTOR_IDENTITY_CONFIG_SEED=<txid>#<index of the configuration seal seed>
# VECTOR_IDENTITY_POLICY_ID=<56 hex: optional check of the identity policy>
# Reference-script UTxOs (<txid>#<index>), each needed only by the tools that spend through it:
# VECTOR_IDENTITY_REF_UTXO=
# VECTOR_IDENTITY_ATTESTATION_REF_UTXO=
# VECTOR_IDENTITY_DELEGATION_REF_UTXO=
# VECTOR_IDENTITY_VAULT_REF_UTXO=
# VECTOR_IDENTITY_ESCROW_REF_UTXO=
# VECTOR_IDENTITY_ADVERT_REF_UTXO=
# VECTOR_IDENTITY_MODULE1_REF_UTXO=
# Optional: the published adoption allowlist (JSON list of identifiers), for adoption proofs.
# VECTOR_IDENTITY_ALLOWLIST_URL=https://

# Module-6 (self-improvement) deployment on the identity registry: the values of its deploy state. No defaults. Set every
# required value or none: without them the self-improvement build tools answer "not configured", and the read tools can
# still read the previous deployment (deployment: 'previous'). A malformed value or a value of the previous deployment
# stops the start.
# GOV_PROPOSAL_SPEND_HASH=
# GOV_PROPOSAL_MINT_HASH=
# GOV_CRITIQUE_SPEND_HASH=
# GOV_CRITIQUE_MINT_HASH=
# GOV_ENDORSEMENT_SPEND_HASH=
# GOV_RECORD_TOKEN_POLICY=
# GOV_REFS_TOKEN_POLICY=
# GOV_PARAMS_ADDRESS=
# GOV_CROSSREFS_ADDRESS=
# GOV_TREASURY_ADDRESS=
# Reference-script UTxOs (<txid>#<index>), each needed only by the tools that spend through it:
# GOV_PROPOSAL_SPEND_REF=
# GOV_PROPOSAL_MINT_REF=
# GOV_CRITIQUE_SPEND_REF=
# GOV_CRITIQUE_MINT_REF=
# GOV_ENDORSEMENT_SPEND_REF=

# Non-custodial migration complete: every builder tool is keyless. Spend
# limits and audit logging are owned entirely by the LOCAL signer, per user -
# see packages/signer/README.md. The server holds no key material and enforces
# no spend limits of its own.

# Auth - when set, every request must carry `Authorization: Bearer <token>`.
# Comma-separated; each entry is `label:token` or a bare token.
# Leave unset for localhost use. Set it on any instance reachable by others.
# MCP_AUTH_TOKENS=alice:replace-me,bob:replace-me-too
