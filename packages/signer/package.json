{
  "name": "@apexfusion/vector-mcp-signer",
  "version": "2.0.0",
  "type": "module",
  "description": "Local signing companion for the Vector MCP server. Holds the key; no network.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
