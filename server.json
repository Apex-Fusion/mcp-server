{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Apex-Fusion/vector",
  "title": "Vector (Apex Fusion)",
  "description": "27 keyless tools for AI agents on Vector, the Apex Fusion eUTXO L2: wallets, registry, marketplace.",
  "version": "2.0.0",
  "repository": {
    "url": "https://github.com/Apex-Fusion/mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://apex-fusion.github.io/vector-ai-documentation/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.vector.{network}.apexfusion.org/mcp",
      "variables": {
        "network": {
          "description": "Vector network to target",
          "isRequired": true,
          "choices": [
            "mainnet",
            "testnet"
          ],
          "default": "mainnet"
        }
      }
    }
  ]
}
