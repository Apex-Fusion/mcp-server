{
  "name": "@apexfusion/mcp-server-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "node scripts/link-libsodium.mjs",
    "clean": "rm -rf packages/*/build",
    "build": "npm run build --workspace=@apexfusion/vector-mcp-builder && npm run build --workspace=@apexfusion/vector-mcp-signer",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/builder && tsc --noEmit -p packages/signer",
    "start": "node packages/builder/build/index.js",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test packages/*/test/*.test.ts",
    "test:smoke": "npm run build && node --import tsx --test packages/builder/test/smoke/*.test.ts",
    "test:smoke:signer": "npm run build && node --import tsx --test packages/signer/test/smoke/*.test.ts",
    "test:integration": "npm run build && node --import tsx --test packages/builder/test/integration/*.test.ts",
    "test:integration:auth": "npm run build && node --import tsx --test packages/builder/test/integration/auth-gating.test.ts packages/builder/test/integration/rate-limit-gating.test.ts packages/builder/test/integration/streamable-http-gating.test.ts",
    "test:integration:signer": "node --import tsx --test packages/signer/test/integration/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "tar": "^7.5.21",
    "brace-expansion": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "author": "Apex Fusion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apex-Fusion/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Apex-Fusion/mcp-server/issues"
  }
}
